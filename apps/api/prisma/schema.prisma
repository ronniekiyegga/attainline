generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  students    Student[]
  memberships OrganisationMembership[]

  @@map("organisations")
}

model Student {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId        String   @map("organisation_id") @db.Uuid
  institutionStudentRef String   @map("institution_student_ref")
  firstName             String?  @map("first_name")
  surname               String   @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  enrolments StudentEnrolment[]

  @@unique([organisationId, institutionStudentRef])
  @@unique([organisationId, id])
  @@index([organisationId, surname, id])
  @@map("students")
}

model StudentEnrolment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  academicYearStart Int      @map("academic_year_start")
  yearGroup         Int      @map("year_group")
  classGroup        String?  @map("class_group")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [organisationId, studentId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organisationId, studentId, academicYearStart])
  @@index([organisationId, academicYearStart, yearGroup])
  @@map("student_enrolments")
}

enum MembershipRole {
  HEADTEACHER
  HEAD_OF_YEAR
  TEACHER

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganisationMembership[]

  @@map("users")
}

model OrganisationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  yearGroups MembershipYearGroup[]
  sessions   Session[]

  @@unique([userId, organisationId])
  @@unique([userId, id])
  @@index([organisationId])
  @@map("organisation_memberships")
}

model MembershipYearGroup {
  membershipId String @map("membership_id") @db.Uuid
  yearGroup    Int    @map("year_group")

  membership OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([membershipId, yearGroup])
  @@map("membership_year_groups")
}

model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash    Bytes     @unique @map("token_hash")
  userId       String    @map("user_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  membership OrganisationMembership @relation(fields: [userId, membershipId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([membershipId])
  @@map("sessions")
}

model LoginThrottle {
  email           String    @id
  failures        Int
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)

  @@map("login_throttles")
}
